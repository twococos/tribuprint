# Impressora
PRINTER_BACKEND=real
CUPS_SERVER=/run/cups/cups.sock
CUPS_PRINTER=Canon_TS3350
# Ha de ser el nom de l'usuari de l'amfitrió amb uid 1000 (membre de lpadmin)
CUPS_USER=coco
IPPUSB_URL=ipp://localhost:60000/ipp/print

# App
PORT=7100
DATA_DIR=/data
MAX_UPLOAD_MB=50
RETENTION_HOURS=24
ENABLE_OFFICE=false
CUPS_WEB_URL=http://192.168.1.200:631
TZ=Europe/Madrid
